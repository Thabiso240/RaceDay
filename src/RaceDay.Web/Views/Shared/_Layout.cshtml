@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay Athletic Platform</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- RaceDay Custom Sporting CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        var userName = Context.Session.GetString("UserName");
        var userRole = Context.Session.GetString("UserRole");
        var userPic = Context.Session.GetString("UserProfilePic");
        var isAuthenticated = !string.IsNullOrEmpty(userName);
    }

    <!-- Primary Navigation Bar -->
    <nav class="navbar navbar-expand-lg rd-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-stopwatch-fill text-warning fs-3"></i>
                <span>RACE<span class="rd-brand-accent">DAY</span></span>
            </a>
            
            <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarRaceDay">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarRaceDay">
                <!-- Left Nav Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link rd-nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rd-nav-link" asp-controller="Events" asp-action="Index">
                            <i class="bi bi-calendar-event me-1"></i> Browse Events
                        </a>
                    </li>

                    @if (isAuthenticated && userRole == "Participant")
                    {
                        <li class="nav-item">
                            <a class="nav-link rd-nav-link" asp-controller="Participant" asp-action="MyEvents">
                                <i class="bi bi-ticket-perforated me-1"></i> My Enrolments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rd-nav-link" asp-controller="Participant" asp-action="MyResults">
                                <i class="bi bi-trophy me-1"></i> My Results
                            </a>
                        </li>
                    }

                    @if (isAuthenticated && userRole == "Organiser")
                    {
                        <li class="nav-item">
                            <a class="nav-link rd-nav-link" asp-controller="Organiser" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rd-nav-link" asp-controller="Organiser" asp-action="Events">
                                <i class="bi bi-kanban me-1"></i> Manage Events
                            </a>
                        </li>
                    }
                </ul>

                <!-- Right Nav / User Auth Actions -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item me-3">
                            @if (userRole == "Organiser")
                            {
                                <span class="badge-role-organiser">
                                    <i class="bi bi-shield-check me-1"></i> Organiser
                                </span>
                            }
                            else
                            {
                                <span class="badge-role-participant">
                                    <i class="bi bi-person-walking me-1"></i> Athlete
                                </span>
                            }
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" id="userMenu" data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(userPic))
                                {
                                    <img src="@userPic" class="rounded-circle border border-info" width="34" height="34" style="object-fit: cover;" alt="Avatar" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white" style="width:34px; height:34px;">
                                        <i class="bi bi-person"></i>
                                    </div>
                                }
                                <span class="fw-semibold">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear me-2"></i> My Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sport-primary btn-sm px-3" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Join RaceDay
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Global Toast / Alert Notifications -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main View Content -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="rd-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="fw-bold text-white fs-5">RACE<span class="rd-brand-accent">DAY</span></span>
                    <p class="mb-0 text-muted small mt-1">PROG6212 Portfolio of Evidence (POE) &copy; 2026. Built with ASP.NET Core, EF Core, and Azure Blob Storage.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-dark border border-secondary text-light px-3 py-2 me-2">
                        <i class="bi bi-server me-1 text-info"></i> RESTful API Connected
                    </span>
                    <span class="badge bg-dark border border-secondary text-light px-3 py-2">
                        <i class="bi bi-cloud-arrow-up me-1 text-primary"></i> Azure Blob Storage
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
