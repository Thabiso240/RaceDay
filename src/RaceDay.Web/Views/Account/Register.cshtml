@model RegisterViewModel
@{
    ViewData["Title"] = "Join RaceDay - Athlete & Organiser Registration";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="rd-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-dark border border-warning d-inline-flex p-3 mb-2">
                        <i class="bi bi-person-plus fs-2 text-warning"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-1">Create RaceDay Account</h3>
                    <p class="text-muted small">Choose your primary role and join the community</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <!-- Role Selection -->
                    <div class="mb-4">
                        <label class="form-label text-light small fw-bold d-block">Select Your Role</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleParticipant" value="Participant" checked />
                                <label class="btn btn-outline-info w-100 py-3" for="roleParticipant">
                                    <i class="bi bi-person-walking fs-3 d-block mb-1"></i>
                                    <strong class="d-block">Participant</strong>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Enter events & track results</small>
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleOrganiser" value="Organiser" />
                                <label class="btn btn-outline-danger w-100 py-3" for="roleOrganiser">
                                    <i class="bi bi-shield-check fs-3 d-block mb-1"></i>
                                    <strong class="d-block">Organiser</strong>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Create & manage races</small>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label text-light small fw-bold"></label>
                        <input asp-for="FullName" class="form-control bg-dark border-secondary text-white" placeholder="Lerato Sithole" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-light small fw-bold"></label>
                        <input asp-for="Email" class="form-control bg-dark border-secondary text-white" placeholder="athlete@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label text-light small fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control bg-dark border-secondary text-white" placeholder="+27 82 000 0000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label text-light small fw-bold"></label>
                            <input asp-for="Password" class="form-control bg-dark border-secondary text-white" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label text-light small fw-bold"></label>
                            <input asp-for="ConfirmPassword" class="form-control bg-dark border-secondary text-white" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sport-primary w-100 py-2 mb-3">
                        <i class="bi bi-check2-circle me-1"></i> Complete Registration
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Already have an account?</span>
                        <a asp-action="Login" class="text-info small fw-bold text-decoration-none ms-1">Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
