@model List<EventDto>
@{
    ViewData["Title"] = "Manage My Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-kanban me-2 text-info"></i>Events Management</h2>
            <p class="text-muted small mb-0">Create, edit, manage categories, and oversee race enrolments</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-sport-primary">
            <i class="bi bi-plus-circle me-1"></i> Create New Event
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rd-card p-5 text-center">
            <i class="bi bi-calendar-plus fs-1 text-muted mb-3 d-block"></i>
            <h4 class="text-white">You Have Not Created Any Events Yet</h4>
            <p class="text-muted mb-4">Click below to publish your first race event and configure categories.</p>
            <a asp-action="CreateEvent" class="btn btn-sport-primary px-4">Create Your First Event</a>
        </div>
    }
    else
    {
        <div class="rd-card p-4">
            <div class="table-responsive">
                <table class="table rd-table align-middle">
                    <thead>
                        <tr>
                            <th>Banner & Title</th>
                            <th>Discipline</th>
                            <th>Date & Venue</th>
                            <th>Distance</th>
                            <th>Enrolments</th>
                            <th>Status</th>
                            <th>Management Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td style="min-width: 260px;">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(ev.BannerImageUrl) ? "https://images.unsplash.com/photo-1452626038306-9aae5e071dd3?w=200&q=80" : ev.BannerImageUrl)" 
                                             class="rounded border border-secondary" width="70" height="48" style="object-fit: cover;" alt="Banner" />
                                        <div>
                                            <strong class="text-white d-block">@ev.Title</strong>
                                            <small class="text-muted">ID: #@ev.EventId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-info">@ev.EventType</span>
                                </td>
                                <td>
                                    <div><i class="bi bi-calendar3 me-1 text-info"></i> @ev.EventDate.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 180px;">@ev.Location</small>
                                </td>
                                <td>@ev.DistanceKm km</td>
                                <td>
                                    <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="badge bg-dark border border-secondary text-info fs-6 text-decoration-none px-3 py-1">
                                        <i class="bi bi-people me-1"></i> @ev.TotalEnrolments
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @(ev.Status == "Completed" ? "bg-secondary" : "bg-success")">
                                        @ev.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-outline-info btn-sm" title="Edit Event Details">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-outline-secondary btn-sm text-white" title="Manage Categories">
                                            <i class="bi bi-diagram-3"></i> Categories
                                        </a>
                                        <a asp-action="CaptureResults" asp-route-eventId="@ev.EventId" class="btn btn-sport-primary btn-sm" title="Capture Results">
                                            <i class="bi bi-trophy"></i> Results
                                        </a>
                                        <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this event? This cannot be undone.');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Event">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
